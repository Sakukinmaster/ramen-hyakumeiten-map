import requests
from bs4 import BeautifulSoup
import json

def save_100_ramen_shops():
    url = "https://tabelog.com/award/hyakumeiten/ramen/"
    headers = {
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36",
        "Accept-Language": "ja,en-US;q=0.9,en;q=0.8",
        "Referer": "https://tabelog.com/"
    }

    res = requests.get(url, headers=headers)
    if res.status_code != 200:
        print("페이지 접근 실패")
        return

    soup = BeautifulSoup(res.text, "html.parser")
    shops = []

    # 대체 추출 로직 (100개 수집 성공했던 로직)
    candidate_tags = soup.find_all("a", href=True)
    for a_tag in candidate_tags:
        href = a_tag["href"]
        if "tabelog.com/" in href and "/A" in href and not "/rstLst/" in href:
            name = a_tag.text.strip()
            if not name:
                img = a_tag.find("img")
                if img and img.get("alt"):
                    name = img["alt"].strip()

            if name and len(name) > 1 and name not in ["地図", "写真", "口コミ"]:
                if not any(s['url'] == href for s in shops):
                    shops.append({
                        "name": name,
                        "rating": "3.75",  # 기본 표시용 별점
                        "url": href
                    })

    # 수집한 100개 데이터를 ramen_list.json 파일로 덮어쓰기
    with open("ramen_list.json", "w", encoding="utf-8") as f:
        json.dump(shops, f, ensure_ascii=False, indent=2)

    print(f"성공! 총 {len(shops)}개의 데이터가 'ramen_list.json'에 저장되었습니다.")

if __name__ == "__main__":
    save_100_ramen_shops()